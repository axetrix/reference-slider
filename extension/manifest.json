{
  "manifest_version": 3,
  "name": "Reference Slider",
  "version": "1.2.3",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "description": "Image viewer for supported websites: swipe, zoom and save references to local project collections.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reference Slider",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.ru/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
